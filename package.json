{
  "name": "deiz-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dm": "./dist/dm.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/adapters/cli/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/dm.js --sourcemap && chmod +x dist/dm.js",
    "dm": "tsx src/adapters/cli/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/adapters/cli/index.ts worker",
    "up": "docker compose up -d && ./scripts/garage-init.sh",
    "down": "docker compose down",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:cli": "npm run build && vitest run tests/cli",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.46.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
