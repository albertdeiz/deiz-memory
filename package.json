{
  "name": "deiz-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "dm": "./dist/adapters/cli/index.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dm": "tsx src/adapters/cli/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "up": "docker compose up -d && ./scripts/garage-init.sh",
    "down": "docker compose down",
    "test:up": "docker compose -f compose.test.yml up -d && ./scripts/garage-init.sh test",
    "test:down": "docker compose -f compose.test.yml down -v",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:cli": "npm run build && vitest run tests/cli"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
